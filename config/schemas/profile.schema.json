{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "$defs": {
    "verifiedDate": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/verifiedValue" },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": ["string", "null"],
              "pattern": "^(?:\\d{4}-(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:04|06|09|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[13579][26]|[2468][048]|0[48])00)-02-29)$"
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "required": ["schema_version", "targets", "locations", "availability", "transport", "languages", "education", "legal", "constraints", "compensation"],
  "properties": {
    "schema_version": { "const": 1 },
    "identity": {
      "type": "object",
      "required": ["name", "email", "phone"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/verifiedValue" },
        "email": { "$ref": "common.schema.json#/$defs/verifiedValue" },
        "phone": { "$ref": "common.schema.json#/$defs/verifiedValue" }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "object",
      "required": ["primary_archetypes", "fallback_archetypes", "agencies_policy"],
      "properties": {
        "primary_archetypes": { "$ref": "common.schema.json#/$defs/verifiedValue" },
        "fallback_archetypes": { "$ref": "common.schema.json#/$defs/verifiedValue" },
        "agencies_policy": { "$ref": "common.schema.json#/$defs/verifiedValue" }
      },
      "additionalProperties": false
    },
    "locations": {
      "type": "object",
      "required": ["city", "radius_km", "public_transport_required"],
      "properties": {
        "city": { "$ref": "common.schema.json#/$defs/verifiedValue" },
        "radius_km": { "$ref": "common.schema.json#/$defs/verifiedValue" },
        "public_transport_required": { "$ref": "common.schema.json#/$defs/verifiedValue" }
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": ["target_start"],
      "properties": {
        "target_start": { "$ref": "common.schema.json#/$defs/verifiedValue" },
        "relocation_date": { "$ref": "#/$defs/verifiedDate" },
        "available_from": { "$ref": "#/$defs/verifiedDate" }
      },
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "required": ["driver_licence", "has_car"],
      "properties": {
        "driver_licence": { "$ref": "common.schema.json#/$defs/verifiedValue" },
        "has_car": { "$ref": "common.schema.json#/$defs/verifiedValue" }
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "object",
      "required": ["english", "german"],
      "properties": {
        "ukrainian": { "$ref": "common.schema.json#/$defs/verifiedValue" },
        "russian": { "$ref": "common.schema.json#/$defs/verifiedValue" },
        "english": { "$ref": "common.schema.json#/$defs/verifiedValue" },
        "german": { "$ref": "common.schema.json#/$defs/verifiedValue" }
      },
      "additionalProperties": false
    },
    "education": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "$ref": "common.schema.json#/$defs/verifiedValue" } },
      "additionalProperties": false
    },
    "legal": {
      "type": "object",
      "required": ["work_authorization", "education_equivalence"],
      "properties": {
        "work_authorization": {
          "oneOf": [
            {
              "type": "object",
              "required": ["value", "verification_status", "provenance"],
              "properties": {
                "value": { "type": "null" },
                "verification_status": { "const": "unknown" },
                "provenance": { "type": "array", "maxItems": 0 }
              },
              "additionalProperties": false
            },
            {
              "allOf": [
                { "$ref": "common.schema.json#/$defs/verifiedValue" },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "object",
                      "required": ["status", "basis", "employment_access", "sponsorship_required", "available_from"],
                      "properties": {
                        "status": { "const": "planned_after_arrival" },
                        "basis": { "const": "§24 AufenthG (temporary protection)" },
                        "employment_access": { "const": "full_once_issued" },
                        "sponsorship_required": { "const": false },
                        "available_from": {
                          "type": "string",
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        }
                      },
                      "additionalProperties": false
                    },
                    "verification_status": {
                      "enum": ["user_confirmed", "document_verified"]
                    }
                  }
                }
              ]
            }
          ]
        },
        "education_equivalence": {
          "type": "object",
          "required": ["value", "verification_status", "provenance"],
          "properties": {
            "value": { "type": "null" },
            "verification_status": { "const": "unknown" },
            "provenance": { "type": "array", "maxItems": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "required": ["night_shifts", "continuous_heavy_work"],
      "properties": {
        "night_shifts": { "$ref": "common.schema.json#/$defs/verifiedValue" },
        "continuous_heavy_work": { "$ref": "common.schema.json#/$defs/verifiedValue" }
      },
      "additionalProperties": false
    },
    "compensation": {
      "type": "object",
      "required": ["net_monthly_estimate"],
      "properties": { "net_monthly_estimate": { "$ref": "common.schema.json#/$defs/verifiedValue" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
