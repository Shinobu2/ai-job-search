{
  "version": "extraction-v1",
  "fields": [
    { "id": "title", "heading": true, "rule_id": "title.heading" },
    { "id": "company", "label": "Company", "rule_id": "company.label" },
    { "id": "location", "label": "Location", "rule_id": "location.label" },
    { "id": "exact_workplace", "label": "Exact workplace", "rule_id": "exact_workplace.label" },
    { "id": "employment_type", "label": "Employment", "rule_id": "employment_type.label" },
    { "id": "contract_type", "label": "Contract type", "rule_id": "contract_type.label" },
    { "id": "salary", "label": "Salary", "rule_id": "salary.label" },
    { "id": "languages", "label": "Languages", "rule_id": "languages.label" },
    { "id": "education", "label": "Education", "rule_id": "education.label" },
    { "id": "experience", "label": "Experience", "rule_id": "experience.label" },
    { "id": "skills", "label": "Skills", "rule_id": "skills.label" },
    { "id": "certifications", "label": "Certifications", "rule_id": "certifications.label" },
    { "id": "shift", "label": "Shift", "rule_id": "shift.label" },
    { "id": "on_call", "label": "On-call", "rule_id": "on_call.label" },
    { "id": "car", "label": "Car", "rule_id": "car.label" },
    { "id": "physical_requirements", "label": "Physical", "rule_id": "physical_requirements.label" },
    { "id": "training", "label": "Training", "rule_id": "training.label" },
    { "id": "seniority", "label": "Seniority", "rule_id": "seniority.label" },
    { "id": "deadline", "label": "Deadline", "rule_id": "deadline.label" }
  ],
  "derived_fields": [
    { "id": "night_work", "source": "shift", "pattern": "night", "value": "required", "rule_id": "night_work.shift_keyword" },
    { "id": "shift", "source": "title", "pattern": "24\\s*/\\s*7|schichtdienst", "value": "rotating schedule; nights must be verified", "rule_id": "shift.title_rotation" }
  ],
  "requirements": [
    { "field": "skills", "type": "skill", "separator": ",", "rule_id": "skills.requirements" }
  ],
  "jobsuche_skill_rules": [
    { "id": "pc_hardware", "pattern": "\\b(?:pc |computer\\/)?hardware\\b|komponenten", "value": "PC hardware" },
    { "id": "server_hardware", "pattern": "\\bservers?\\b|serverhardware", "value": "server hardware" },
    { "id": "networking", "pattern": "network|netzwerk|routers?|switches?", "value": "networking" },
    { "id": "cabling", "pattern": "cabling|verkabelung|kabelmanagement", "value": "cabling" },
    { "id": "hardware_troubleshooting", "pattern": "troubleshoot|hardware replacement|repair|fehlersuche|störungsbehebung|reparatur|instandhaltung", "value": "hardware troubleshooting" },
    { "id": "linux", "pattern": "\\blinux\\b", "value": "Linux" },
    { "id": "windows_server", "pattern": "windows server|active directory|\\bAD\\b|\\bDNS\\b|\\bDHCP\\b|gruppenrichtlinien", "value": "Windows Server / AD / DNS / DHCP" },
    { "id": "noc_monitoring", "pattern": "\\bNOC\\b|network operations cent(?:er|re)|infrastrukturmonitoring|systemüberwachung|monitoring", "value": "NOC / infrastructure monitoring" },
    { "id": "service_desk", "pattern": "service desk|help ?desk|ticket(?:ing|system)?|störungsticket", "value": "service desk / ticket handling" },
    { "id": "itil_ticketing", "pattern": "\\bITIL\\b|ticket(?:ing|system)?|störungsticket", "value": "ITIL / ticket handling" },
    { "id": "user_support", "pattern": "user support|benutzersupport|anwendersupport", "value": "user support" },
    { "id": "datacenter_components", "pattern": "\\bRAID\\b|\\bSFP\\+?\\b|\\bKVM\\b", "value": "RAID / SFP / KVM" },
    { "id": "it_rollout_break_fix", "pattern": "IT[- ]?Rollout|break[- ]?fix|Gerätetausch|client rollout", "value": "IT rollout / break-fix" },
    { "id": "electronics_assembly", "pattern": "Gerätemontage|Elektronikmontage|Baugruppenmontage|electronic(?:s)? assembly", "value": "electronics assembly" },
    { "id": "quality_inspection", "pattern": "Qualitätsprüfung|Qualitätskontrolle|Sichtprüfung|quality inspection|quality control", "value": "quality inspection" },
    { "id": "warehouse_it_scanner", "pattern": "Scanner[- ]?Support|MDE[- ]?Gerät|warehouse IT|Lager-IT", "value": "warehouse IT / scanner support" },
    { "id": "machine_operation", "pattern": "Maschinenbedien|Anlagenbedien|machine operator|equipment operator", "value": "machine / equipment operation" },
    { "id": "career_changer", "pattern": "Quereinsteiger|career changer|entry level welcome", "value": "career changer welcome" }
  ]
}
